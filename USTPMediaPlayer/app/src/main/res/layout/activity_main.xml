<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F141A">

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USTP Media Player"
            android:textColor="#EAF2FF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect to USTP server and play with packet-loss recovery."
            android:textColor="#9DB0C9"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server IP or Domain"
            android:textColor="#EAF2FF"
            android:textColorHint="#7E8EA4" />

        <EditText
            android:id="@+id/etPlayoutDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stability Delay (ms)"
            android:textColor="#EAF2FF"
            android:textColorHint="#7E8EA4"
            android:inputType="number"
            android:text="140" />

        <TextView
            android:id="@+id/tvHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lower delay = lower latency (may stutter). Higher delay = more stable."
            android:textColor="#9DB0C9"
            android:textSize="12sp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect and Play" />

        <Button
            android:id="@+id/btnFullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fullscreen Player"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Idle"
            android:textColor="#C5D3E6"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:use_controller="true" />
    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="true" />
</FrameLayout>
